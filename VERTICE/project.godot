; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VÉRTICE"
config/description="O Limiar da Existência — Aventura cinematográfica 2D em Realismo Surreal com mecânica de Ressonância."
config/version="0.6.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.0235, 0.0275, 0.0353, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"
run/max_fps=30

[autoload]

TextureFactory2D="*res://scripts/texture_factory_2d.gd"
SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
ResonanceSystem="*res://scripts/resonance_system.gd"
ChapterProgression="*res://scripts/chapter_progression.gd"
GameManager="*res://scripts/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

